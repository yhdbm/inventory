{
  "manifest_version": 3,
  "name": "ServiceNow AutoPilot",
  "version": "4.0.0",
  "description": "Automate repetitive ServiceNow tasks with Bulk Tasks and Surgical Tasks.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ServiceNow AutoPilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon_idle_16.png",
      "32": "icons/icon_idle_32.png",
      "48": "icons/icon_idle_48.png",
      "128": "icons/icon_idle_128.png"
    }
  },
  "icons": {
    "16": "icons/icon_idle_16.png",
    "32": "icons/icon_idle_32.png",
    "48": "icons/icon_idle_48.png",
    "128": "icons/icon_idle_128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
